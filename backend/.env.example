# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=F1E8QvpUYJP71zWz4NwYpPtpUszfp8wb2nKjnrzF2Cmh

# MagicBlock Ephemeral Rollups (ER) — routes pay_reward txs for ~10ms confirms
MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app
MAGICBLOCK_WS_URL=wss://devnet-router.magicblock.app

# Platform signer — NEVER commit, NEVER log, NEVER send to frontend
# Generate: solana-keygen new --outfile /tmp/platform-authority.json
# Encode: node -e "const fs=require('fs');const bs58=require('bs58');const secret=JSON.parse(fs.readFileSync('/tmp/platform-authority.json'));console.log(bs58.encode(Buffer.from(secret)));"
PLATFORM_AUTHORITY_PRIVATE_KEY=

# Treasury PDA — set after running init-treasury.ts
PLATFORM_TREASURY_PUBKEY=
