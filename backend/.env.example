# Stellar Testnet Configuration
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TESTNET_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Platform Authority — Stellar secret key (starts with S)
# Generate: const keypair = StellarSdk.Keypair.random(); keypair.secret()
# NEVER commit, NEVER log to production, NEVER send to frontend
PLATFORM_AUTHORITY_SECRET_KEY=S...

# Escrow Account — Stellar public key (starts with G...)
# Can be same as authority public key or a dedicated escrow account
# Public key from authority: const keypair = StellarSdk.Keypair.fromSecret(secret); keypair.publicKey()
PLATFORM_ESCROW_ACCOUNT=G...

# Supabase Configuration (Stellar version database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Server Configuration
NODE_ENV=development
PORT=3000

