# Stellar Testnet Configuration
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TESTNET_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Solo payouts are signed by the solo treasury. Generate with:
#   const kp = StellarSdk.Keypair.random(); kp.secret()
# Fund via friendbot: https://friendbot.stellar.org?addr=<publicKey>
STELLAR_SOLO_TREASURY_PUBLIC_KEY=G...
STELLAR_SOLO_TREASURY_SECRET_KEY=S...

# Duel treasury (separate account so duel escrow never collides with solo)
STELLAR_DUEL_TREASURY_PUBLIC_KEY=G...
STELLAR_DUEL_TREASURY_SECRET_KEY=S...

# Soroban contract IDs (deployed; required for payout escrow on Testnet)
STELLAR_SOLO_CONTRACT_ID=C...
STELLAR_DUEL_CONTRACT_ID=C...

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server Configuration
NODE_ENV=development
PORT=5000

